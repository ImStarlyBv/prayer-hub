<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}{% if title %} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or excerpt or site.description }}">
  {%- if noindex or (cat and not (cat.slug | isPopulated(collections.prayers))) %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- set metaDescription = description or excerpt or site.description %}
  {%- set fullTitle = (title + " · " + site.name) if title else site.name %}
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{{ 'article' if excerpt else 'website' }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/images/logo.png">
  <meta property="og:locale" content="en_US">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ title or site.name }}">
  <meta name="twitter:description" content="{{ metaDescription }}">
  {%- if dateModified %}
  <meta property="article:modified_time" content="{{ dateModified | isoDate }}">
  {%- endif %}
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ site.url }}/rss.xml">

  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,1,0&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/styles.css">
  {%- if category and excerpt %}
  {{ page.url | prayerJsonLd | safe }}
  {%- elif cat %}
  {{ page.url | categoryJsonLd | safe }}
  {%- elif page.url == "/" %}
  {{ page.url | homeJsonLd | safe }}
  {%- endif %}
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">
      <img src="/images/logo.png" alt="{{ site.name }} crest" width="32" height="32">
      <span>{{ site.name }}</span>
    </a>
    <nav class="site-nav">
      {% for c in categories | populated(collections.prayers) %}
      <a href="/{{ c.slug }}/">{{ c.title }}</a>
      {% endfor %}
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>❦ ✠ ❦</p>
    <p>&copy; {{ currentYear }} {{ site.name }}. Updated daily.</p>
    <p class="links"><a href="/archive/">Archive</a> · <a href="/about/">About</a> · <a href="/rss.xml">RSS</a> · <a href="/sitemap.xml">Sitemap</a></p>
  </footer>
</body>
</html>
